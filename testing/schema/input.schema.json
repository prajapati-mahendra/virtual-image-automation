{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["galleries"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "galleries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "subscription", "resourceGroup"],
        "properties": {
          "name": {
            "type": "string"
          },
          "definitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "description", "architecture", "location", "osType"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "architecture": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "osType": {
                  "type": "string"
                },
                "versions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name", "location","publishedDate","sizeInGB"],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "location": {
                        "type": "string"
                      },
                      "publishedDate": {
                        "type": "string"
                      },
                      "sizeInGB": {
                        "type": "number"
                      }
                    }
                  },
                  "additionalItems": false
                }
              },
              "additionalProperties": false
            }
          },
          "subscription": {
            "type": "string"
          },
          "resourceGroup": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "osFilter": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
